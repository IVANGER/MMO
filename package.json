{
  "name": "hero-camp",
  "version": "0.1.0",
  "description": "Реалтайм MMO-lite с открытым миром",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
